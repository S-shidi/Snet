# Copy to deploy-prod/docker-server/.env on the VPS; never commit the real .env.
# Generate secrets without printing them:
#   umask 077 && openssl rand -hex 32
SNET_RELAY_SECRET=

# Public SnetServ URL embedded in invites.
SNETSERV_PUBLIC_URL=https://snet.uizhi.eu.org:8090

# Public Relay v2 endpoint advertised to clients (UDP 8092).
SNET_RELAY_V2_ENDPOINTS=snet.uizhi.eu.org:8092

# Shared secret between snetserv internal RPC and admin-server.
SNET_INTERNAL_ADMIN_TOKEN=
# Private network allowed to reach the internal Admin RPC.
# Loopback is always allowed; the service token is still required.
SNET_INTERNAL_ADMIN_ALLOW_CIDR=10.88.0.0/16
# Interface/IP Docker binds 8096 to. Set to the VPS SNET IP when admin-server
# runs on another SNET member (e.g. 10.88.0.1); keep 127.0.0.1 for local-only.
SNET_INTERNAL_BIND_IP=127.0.0.1

# Optional: override if Let's Encrypt paths differ.
# TLS_CERT_PATH=/etc/letsencrypt/live/snet.uizhi.eu.org/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/snet.uizhi.eu.org/privkey.pem

# Optional: target VPS architecture for the prebuilt binary image.
# Run `uname -m` on the VPS: x86_64 => amd64, aarch64 => arm64.
# BIN_ARCH=amd64

# Optional official Hub used by WireGuard config export
SNET_HUB_NODE_ID=
SNET_HUB_PUBLIC_KEY=
SNET_HUB_ENDPOINT=
