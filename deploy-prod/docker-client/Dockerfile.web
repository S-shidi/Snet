# Stage 1: build shared/web with the Docker adapter.
# shared/web has no package.json/build script; the adapter lives in deploy/docker/web-build.
FROM node:20-alpine AS builder
WORKDIR /app

COPY deploy/docker/web-build/package.json deploy/docker/web-build/package-lock.json ./
RUN npm ci --omit=dev

COPY shared/web ./shared/web
COPY deploy/docker/web-build/web.ts ./deploy/docker/web-build/web.ts

RUN npx --yes esbuild@0.25.12 deploy/docker/web-build/web.ts \
      --bundle --format=iife --target=es2022 --minify \
      --outfile=dist/app.js \
 && cp shared/web/index.html shared/web/styles.css dist/

# Stage 2: nginx serves static files and proxies /ctl to host snetd.
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy-prod/docker-client/nginx.conf /etc/nginx/snet.conf.template
COPY deploy-prod/docker-client/docker-entrypoint.sh /docker-entrypoint-snet.sh
RUN chmod +x /docker-entrypoint-snet.sh
ENTRYPOINT ["/docker-entrypoint-snet.sh"]
CMD ["nginx", "-g", "daemon off;"]
