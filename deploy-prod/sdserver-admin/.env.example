# Copy to deploy-prod/sdserver-admin/.env on the admin host; never commit it.
SNET_VERSION=v1.2.1

# Bind the admin console to the internal LAN (not 0.0.0.0 / public).
SNET_ADMIN_BIND=10.10.11.11:8095

# VPS SnetServ SNET virtual IP + internal Admin RPC port.
SNETSERV_INTERNAL_URL=http://10.88.0.1:8096

# Must match SNET_INTERNAL_ADMIN_TOKEN on the VPS.
SNET_INTERNAL_ADMIN_TOKEN=
# Compatibility alias for deployments that use this name.
SNET_ADMIN_INTERNAL_TOKEN=

# Admin console login.
SNET_ADMIN_USER=admin
SNET_ADMIN_PASSWORD=
