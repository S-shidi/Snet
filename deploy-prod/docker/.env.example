# Copy to deploy-prod/docker/.env on the VPS; never commit the real .env.
# Generate the secret without printing it:
#   umask 077 && openssl rand -hex 32
SNET_RELAY_SECRET=

# Public Relay v2 endpoint advertised to clients (UDP 8092).
SNET_RELAY_V2_ENDPOINTS=snet.uizhi.eu.org:8092

# Optional: override if Let's Encrypt paths differ.
# TLS_CERT_PATH=/etc/letsencrypt/live/snet.uizhi.eu.org/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/snet.uizhi.eu.org/privkey.pem

# Optional: target VPS architecture for the prebuilt binary image.
# Run `uname -m` on the VPS: x86_64 => amd64, aarch64 => arm64.
# BIN_ARCH=amd64
