# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/client/snetd ./cmd/client/snetd
COPY cmd/client/snetctl ./cmd/client/snetctl
COPY internal ./internal

ARG CGO_ENABLED=0
ARG GOOS=linux
RUN CGO_ENABLED=${CGO_ENABLED} GOOS=${GOOS} \
    go build -trimpath -ldflags="-s -w" -o /out/snetd ./cmd/client/snetd && \
    CGO_ENABLED=${CGO_ENABLED} GOOS=${GOOS} \
    go build -trimpath -ldflags="-s -w" -o /out/snetctl ./cmd/client/snetctl

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/snetd /usr/local/bin/snetd
COPY --from=build /out/snetctl /usr/local/bin/snetctl
ENTRYPOINT ["/usr/local/bin/snetd"]
