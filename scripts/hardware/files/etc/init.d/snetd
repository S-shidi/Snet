#!/bin/sh /etc/rc.common
# procd service for the SNET daemon on OpenWrt.
USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/snetd
CONFIG=/etc/snet/config.json
DEVICE_ID=/etc/snet/device.id
LOG=/var/log/snetd.log

start_service() {
	mkdir -p /etc/snet
	chmod 700 /etc/snet

	procd_open_instance
	procd_set_param command "$PROG" \
		-config "$CONFIG" \
		-device-id-file "$DEVICE_ID" \
		-log-file "$LOG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$CONFIG"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "snet"
}
